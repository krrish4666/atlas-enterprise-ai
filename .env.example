# ═══════════════════════════════════════════════════════════════════════════════
# Atlas Enterprise AI — Environment Variables Template
# Copy to .env and fill in real values. Never commit .env to source control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Connection string for the main atlas database (used by FastAPI / SQLAlchemy)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlaspassword
DATABASE_URL=postgresql+psycopg://atlas:atlaspassword@localhost:5432/atlas

# ── Object Storage (RustFS locally, Backblaze B2 in cloud) ────────────────────
# Internal endpoint: used by FastAPI (http://rustfs:9000 locally, or https://s3.<region>.backblazeb2.com in cloud)
S3_ENDPOINT_URL=http://rustfs:9000
# Public endpoint: used ONLY to sign presigned PUT URLs the browser can reach
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=atlas-docs
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path
S3_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Embeddings (Native Ollama locally, Gemini API in cloud) ───────────────────
# Options: "ollama" (Local Dev default) or "gemini" (Render / 24x7 Cloud Demo)
EMBED_PROVIDER=ollama
# Host dev / local tests connect to localhost:11434.
# When running inside Docker, docker-compose.yml overrides this to http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
# Used when EMBED_PROVIDER=gemini (enforces output_dimensionality=768 to match pgvector(768))
GEMINI_EMBED_MODEL=models/gemini-embedding-001
EMBED_DIM=768

# ── Google Gemini API (Free Tier) ─────────────────────────────────────────────
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Langfuse (SDK v4 OpenTelemetry -> Langfuse Cloud) ─────────────────────────
# Point local dev to a free Langfuse Cloud project (e.g., atlas-local-dev on https://cloud.langfuse.com),
# or set LANGFUSE_ENABLED=false when running offline.
LANGFUSE_ENABLED=true
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key

# ── RAG / Guardrail Thresholds ────────────────────────────────────────────────
# Number of top-K chunks retrieved per query
RETRIEVAL_TOP_K=3
# Maximum characters included per chunk context snippet
MAX_CHUNK_CHARS=450
# Cosine similarity score below which a response is routed to HITL
HITL_CONFIDENCE_THRESHOLD=0.40
# Per-IP chat rate limit (requests per minute) for demo quota protection
CHAT_RATE_LIMIT_PER_MINUTE=20

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Production Deployment (docker-compose.prod.yml / Azure Ubuntu VM) ─────────
# Lowercase GitHub owner/repo for ghcr.io image pull (e.g. yourorg/atlas-enterprise-ai)
# GITHUB_REPOSITORY=yourorg/atlas-enterprise-ai
# Domain name for automatic HTTPS via Caddy (leave unset for HTTP on :80)
# ATLAS_DOMAIN=atlas.yourdomain.com
# In prod HTTPS, set S3_PUBLIC_ENDPOINT_URL=https://atlas.yourdomain.com so Caddy proxies uploads without mixed-content errors
# LANGFUSE_NEXTAUTH_URL=http://localhost:3000

